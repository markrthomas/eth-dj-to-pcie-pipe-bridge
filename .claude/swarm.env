# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=eth-dj-to-pcie-pipe-bridge
GH_REPO=markrthomas/eth-dj-to-pcie-pipe-bridge
DUT_TOP=eth_dj_pipe7_bridge

RTL_DIR=rtl
TB_DIR=dv

DV_ENVS="iverilog vlt systemc cocotb uvm"
GATE_TARGET=regress
CI_TARGET=ci
CROSSCHECK_TARGET=crosscheck
INFRA_TARGETS="formal upf-tb wave-check-all dashboard"
HEAVY_TARGETS="uvm vlt rr-build formal ci"

MUTATION_FILE=rtl/eth_egress.sv
MUTATION_HINT="corrupt one byte on 1-byte last beats"

RR_DIR=dv/random
RR_STATUS=present

METRICS=yes
METRICS_FLOWS=regress,coverage,systemc,cocotb,uvm,formal,upf-tb
